{
  "name": "@eclesia/gno-modules-pg",
  "version": "3.0.0",
  "description": "Eclesia PostgreSQL indexing modules for gno.land (blocks, transactions, messages, events, packages, validators)",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && tsdown",
    "postbuild": "copyfiles -u 1 \"src/**/*.sql\" dist",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "dist/"
  ],
  "keywords": [],
  "contributors": [
    "Alex M.<alex.megalokonomos@tendermint.com>"
  ],
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/allinbits/eclesia-indexer-core.git",
    "directory": "packages/gno-modules"
  },
  "homepage": "https://github.com/allinbits/eclesia-indexer-core#readme",
  "bugs": {
    "url": "https://github.com/allinbits/eclesia-indexer-core/issues"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@eslint/js": "^9.39.5",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "copyfiles": "^2.4.1",
    "eslint": "^9.39.5",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "pg": "^8.23.0",
    "tsdown": "^0.16.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11",
    "winston": "^3.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@eclesia/basic-pg-indexer": "workspace:^",
    "@eclesia/chain-gno": "workspace:^",
    "@eclesia/indexer-engine": "workspace:^",
    "@gnolang/tm2-rpc": "^1.0.0"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts"
}
