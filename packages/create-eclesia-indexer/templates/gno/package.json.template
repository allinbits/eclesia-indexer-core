{
  "name": "{{PROJECT_NAME}}",
  "version": "1.0.0",
  "description": "{{DESCRIPTION}}",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && tsdown && {{PACKAGE_MANAGER}} run postbuild",
    "postbuild": "copyfiles -u 1 \"src/**/*.sql\" dist",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "docker:build": "docker compose build --no-cache",
    "local-dev:start": "docker compose up -d",
    "local-dev:stop": "docker compose down"
  },
  "bin": {
    "{{PROJECT_NAME}}": "./dist/index.js"
  },
  "keywords": [
    "{{CHAIN_FAMILY}}",
    "indexer",
    "{{CHAIN_NAME}}",
    "blockchain"
  ],
  "author": "",
  "license": "SEE LICENSE IN LICENSE.md",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@eclesia/basic-pg-indexer": "^4.0.0",
    "@eclesia/chain-gno": "^4.0.0",
    "@eclesia/gno-modules-pg": "^4.0.0",
    "@eclesia/indexer-engine": "^4.0.0",
    "dotenv": "^17.4.2",
    "@gnolang/gno-types": "^1.0.8",
    "@gnolang/tm2-rpc": "^1.0.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.2",
    "@eslint/js": "^9.35.0",
    "@stylistic/eslint-plugin": "^5.3.1",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.5",
    "copyfiles": "^2.4.1",
    "eslint": "^9.35.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "tsdown": "^0.16.8",
    "tsx": "^4.19.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0"
  },
  "pnpm": {
    "overrides": {
      "@scure/base@>=2.3.0": "2.2.0"
    }
  },
  "overrides": {
    "@scure/base": "2.2.0"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  }
}
