# {{PROJECT_NAME}} Configuration

# Chain RPC endpoint
RPC_ENDPOINT={{RPC_ENDPOINT}}
# Optional: network id the RPC must report; the indexer refuses to index any other chain
CHAIN_ID=
# Optional: cap on HTTP requests per second to the RPC (gno.land only). Calls are batched up to 20 per
# request when this is set; public endpoints such as rpc.gno.land allow about 1000 requests per 5 minutes
RPC_REQUESTS_PER_SECOND=

# Database connection (host-side; docker-compose overrides it with the container hostname)
PG_CONNECTION_STRING={{PG_CONNECTION_STRING}}
# Generated at scaffold time. Used by docker-compose for the Postgres container and Hasura.
POSTGRES_PASSWORD={{POSTGRES_PASSWORD}}
HASURA_GRAPHQL_ADMIN_SECRET={{HASURA_ADMIN_SECRET}}

# Indexer settings
LOG_LEVEL={{LOG_LEVEL}}
QUEUE_SIZE={{QUEUE_SIZE}}
PROCESS_GENESIS={{PROCESS_GENESIS}}
# Path to the genesis file, used only when PROCESS_GENESIS=true
GENESIS_PATH=./genesis.json
MINIMAL={{MINIMAL}}
# Bech32 address prefix (Cosmos SDK chains; unused for gno.land)
CHAIN_PREFIX={{CHAIN_PREFIX}}
USE_POLLING={{USE_POLLING}}
ENABLE_PROMETHEUS=false
PROMETHEUS_PORT=9090
# Optional: Start from specific height
START_HEIGHT={{START_HEIGHT}}