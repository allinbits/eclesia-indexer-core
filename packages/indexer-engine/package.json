{
  "name": "@eclesia/indexer-engine",
  "version": "2.16.2",
  "description": "Core eclesia indexer engine",
  "scripts": {
    "build": "tsc --noEmit && tsdown",
    "bench": "vitest bench --config benchmarks/vitest.config.ts",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "dist/"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "keywords": [],
  "contributors": [
    "Alex M.<alex.megalokonomos@tendermint.com>"
  ],
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/allinbits/eclesia-indexer-core.git",
    "directory": "packages/indexer-engine"
  },
  "homepage": "https://github.com/allinbits/eclesia-indexer-core#readme",
  "bugs": {
    "url": "https://github.com/allinbits/eclesia-indexer-core/issues"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@eslint/js": "^9.39.5",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24.13.3",
    "eslint": "^9.39.5",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "tsdown": "^0.16.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@cosmjs/encoding": "^0.36.2",
    "@cosmjs/tendermint-rpc": "^0.36.2",
    "bech32": "^2.0.0",
    "cosmjs-types": "^0.10.1",
    "fastify": "^5.12.3",
    "prom-client": "^15.1.3",
    "stream-chain": "^4.2.5",
    "stream-json": "^3.6.0",
    "winston": "^3.19.0"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts"
}
