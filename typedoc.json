{
  "entryPoints": [
    "packages/indexer-engine",
    "packages/chain-cosmos",
    "packages/chain-gno",
    "packages/basic-indexer-pg",
    "packages/cosmos-modules",
    "packages/gno-modules"
  ],
  "out": "docs/api",
  "name": "Eclesia Indexer Core API",
  "readme": "README.md",
  "includeVersion": true,
  "sort": [
    "source-order"
  ],
  "categorizeByGroup": true,
  "defaultCategory": "Core",
  "categoryOrder": [
    "Core",
    "Indexer Engine",
    "Database",
    "Modules",
    "Utilities",
    "*"
  ],
  "navigation": {
    "includeCategories": true,
    "includeGroups": true
  },
  "plugin": [],
  "exclude": [
    "**/*.test.ts",
    "**/*.bench.ts",
    "**/node_modules/**",
    "**/dist/**"
  ],
  "entryPointStrategy": "packages"
}
